# Public site origin. A Cloudflare Pages preview subdomain until the real domain is
# wired in (owner decision D5). Read by the A5 PDF QR codes and the WhatsApp share
# caption, so changing the domain is this one variable plus a rebuild.
SITE_URL=https://merahaq.pages.dev

# Supabase — owner decision D2. Login is optional and non-blocking: when these are
# absent the login surfaces do not render at all, rather than erroring. Nothing else
# in the product depends on them.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Legal gate — owner decision D1. While false, every rights surface (card pages,
# /sabhi-card, /aapke-card, /madad, and the generated PNGs and PDFs) carries the
# «कानूनी समीक्षा बाकी है» banner. Flip to true and set the reviewer name only when
# the written sign-off email exists (Build Manual Part I).
PUBLIC_LEGAL_SIGNOFF=false
PUBLIC_REVIEWER_NAME=
