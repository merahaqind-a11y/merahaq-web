---
import type { IconName } from '../../lib/cards';

interface Props {
  name: IconName;
  size?: number;
}
const { name, size = 28 } = Astro.props;

/**
 * Outline icons drawn inline. No icon font, no sprite sheet, no emoji.
 *
 * Emoji were rejected for two reasons: they render differently on every Android skin,
 * and a screen reader announces them as their CLDR name, which for this content is
 * noise at best and misleading at worst. Inline SVG is themeable, weighs nothing, and
 * survives with images blocked.
 *
 * Every icon is aria-hidden, the card title next to it is the accessible name.
 */
const PATHS: Record<IconName, string> = {
  // bangles, streedhan
  jewellery: 'M12 4a8 8 0 100 16 8 8 0 000-16zm0 4a4 4 0 100 8 4 4 0 000-8z',
  // purse with a held clasp, money withheld
  purse: 'M4 9h16v10a2 2 0 01-2 2H6a2 2 0 01-2-2V9zm4 0V6a4 4 0 018 0v3M12 13v3',
  // house, right of residence
  house: 'M4 11l8-6 8 6M6 10v9a1 1 0 001 1h10a1 1 0 001-1v-9',
  // rupee, maintenance
  rupee: 'M7 5h10M7 9h10M7 5c5 0 7 1 7 4s-2 4-7 4l7 6',
  // field and boundary, inheritance
  land: 'M3 17h18M5 17V9l7-4 7 4v8M9 17v-4h6v4',
  // bank columns, her own account
  bank: 'M3 10l9-5 9 5M5 10v7M10 10v7M14 10v7M19 10v7M3 20h18',
  // stacked papers, documents
  papers: 'M8 4h8l3 3v11a2 2 0 01-2 2H8a2 2 0 01-2-2V6a2 2 0 012-2zM9 11h7M9 15h5',
  // scales, free legal aid
  scales: 'M12 4v16M6 8h12M6 8l-3 6h6l-3-6zm12 0l-3 6h6l-3-6zM8 20h8',
  // diya lamp, widow's share
  lamp: 'M5 14c0 3 3 5 7 5s7-2 7-5H5zm7-9c1.5 2 2 3 2 4a2 2 0 11-4 0c0-1 .5-2 2-4z',
  // broken chain link, debt that is not hers
  debt: 'M9 14l6-6M8.5 9.5L7 11a3.5 3.5 0 005 5l1.5-1.5M15.5 14.5L17 13a3.5 3.5 0 00-5-5l-1.5 1.5',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  class="shrink-0 text-pink-700"
>
  <path
    d={PATHS[name]}
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
