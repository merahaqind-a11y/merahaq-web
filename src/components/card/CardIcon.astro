---
import type { IconName } from '../../lib/cards';

interface Props {
  name: IconName;
  size?: number;
}
const { name, size = 32 } = Astro.props;

/**
 * Card icons — richer, layered outline drawings with a soft tinted fill layer behind
 * the primary stroke. Every icon is an authored illustration of what the card is
 * ACTUALLY about, not a generic pictogram. Every icon is aria-hidden; the card title
 * next to it is the accessible name.
 *
 * The "fill" layer is drawn in pink-200 at 60% opacity behind the pink-700 stroke,
 * so the icon reads as a filled illustration on a cheap LCD and as a two-tone
 * drawing on a phone with better colour reproduction — same visual weight either way.
 */
type IconDef = {
  /** background fill shape(s), painted in pink-200/50 */
  fill?: string;
  /** primary stroke path(s), painted in pink-700 */
  stroke: string;
  /** optional accent detail, small path in pink-500 */
  accent?: string;
};

const ICONS: Record<IconName, IconDef> = {
  // Bangles / necklace — streedhan, the woman's jewellery
  jewellery: {
    fill: 'M12 5.5c3 0 5.5 2 5.5 4.5 0 1.5-.7 2.8-1.8 3.6 1 .8 1.6 2 1.6 3.2 0 2.5-2.3 4.2-5.3 4.2S6.7 19.3 6.7 16.8c0-1.2.6-2.4 1.6-3.2C7.2 12.8 6.5 11.5 6.5 10c0-2.5 2.5-4.5 5.5-4.5z',
    stroke: 'M6.5 10c0-2.5 2.5-4.5 5.5-4.5S17.5 7.5 17.5 10c0 1.4-.7 2.7-1.8 3.5M6.5 10c0 1.4.7 2.7 1.8 3.5M8.3 13.5c-1 .8-1.6 2-1.6 3.2 0 2.5 2.3 4.2 5.3 4.2s5.3-1.7 5.3-4.2c0-1.2-.6-2.4-1.6-3.2',
    accent: 'M12 3v2M9 4l.5 1.5M15 4l-.5 1.5',
  },

  // Closed purse with a padlock clasp — money withheld
  purse: {
    fill: 'M5 10h14v9a2 2 0 01-2 2H7a2 2 0 01-2-2v-9z',
    stroke: 'M5 10h14v9a2 2 0 01-2 2H7a2 2 0 01-2-2v-9zM9 10V7a3 3 0 016 0v3',
    accent: 'M12 14v3M10 14h4',
  },

  // House with a small heart above the door — home she has the right to stay in
  house: {
    fill: 'M4 11l8-7 8 7v9a1 1 0 01-1 1H5a1 1 0 01-1-1v-9z',
    stroke: 'M4 11l8-7 8 7M5 10v10a1 1 0 001 1h12a1 1 0 001-1V10',
    accent: 'M10 21v-5a2 2 0 014 0v5M12 8.3c.4-.5 1-.8 1.5-.8.9 0 1.5.7 1.5 1.5 0 1.3-3 3-3 3s-3-1.7-3-3c0-.8.6-1.5 1.5-1.5.5 0 1.1.3 1.5.8z',
  },

  // Rupee note with hand — monthly maintenance
  rupee: {
    fill: 'M4 8h16v9H4z',
    stroke: 'M4 8h16v9H4zM8 8v9M16 8v9',
    accent: 'M10 10h4M10 12h4M10 10c1.5 0 2.5.5 2.5 1.5S11.5 13 10 13l3 3',
  },

  // Two coparceners equally represented — daughter's equal share
  land: {
    fill: 'M12 10a3.5 3.5 0 100-7 3.5 3.5 0 000 7z',
    stroke: 'M5.5 21v-2a4 4 0 014-4h5a4 4 0 014 4v2M12 10a3.5 3.5 0 100-7 3.5 3.5 0 000 7z',
    accent: 'M8 21v-4M16 21v-4M12 21v-6',
  },

  // Bank with a tick inside — her own bank account, no permission needed
  bank: {
    fill: 'M4 11l8-6 8 6v2H4z',
    stroke: 'M4 11l8-6 8 6v2H4zM6 13v7M10 13v7M14 13v7M18 13v7M3 21h18',
    accent: 'M9 17l2 2 4-4',
  },

  // Folder with a locked seal — the papers that are her power
  papers: {
    fill: 'M6 6h5l2 2h5a1 1 0 011 1v10a1 1 0 01-1 1H6a1 1 0 01-1-1V7a1 1 0 011-1z',
    stroke: 'M6 6h5l2 2h5a1 1 0 011 1v10a1 1 0 01-1 1H6a1 1 0 01-1-1V7a1 1 0 011-1z',
    accent: 'M12 14v2M11 12v-1a1 1 0 012 0v1M10 12h4v3h-4z',
  },

  // Scales of justice with a heart on the beam — free legal aid is her right
  scales: {
    fill: 'M4 10h6L7 16h6L10 10zm10 0h6l-3 6h6l-3-6z',
    stroke: 'M12 4v16M6 20h12M12 6l-3 4h6L12 6zM6 10l-3 6h6l-3-6zM18 10l-3 6h6l-3-6z',
    accent: 'M12 4.5c.3-.4.8-.6 1.2-.6.7 0 1.3.6 1.3 1.3 0 1-2.5 2.3-2.5 2.3S9.5 6.2 9.5 5.2c0-.7.6-1.3 1.3-1.3.4 0 .9.2 1.2.6z',
  },

  // Diya lamp with a flame — widow's share, quiet dignity
  lamp: {
    fill: 'M4 14h16v2c0 2-3 4-8 4s-8-2-8-4v-2z',
    stroke: 'M4 14h16v2c0 2-3 4-8 4s-8-2-8-4v-2zM6 14c0-2 3-3 6-3s6 1 6 3',
    accent: 'M12 4c1.2 1.8 2 3 2 4a2 2 0 11-4 0c0-1 .8-2.2 2-4z',
  },

  // Broken chain link — the debt is not hers
  debt: {
    fill: 'M6.5 12a3.5 3.5 0 01.5-2 3.5 3.5 0 015 5 3.5 3.5 0 01-2 .5',
    stroke: 'M10 14l4-4M8.5 10.5L7 12a3.5 3.5 0 005 5l1.5-1.5M15.5 13.5L17 12a3.5 3.5 0 00-5-5l-1.5 1.5',
    accent: 'M3 4l3 3M4 3l3 3M17 17l3 3M18 20l3-3',
  },
};

const def = ICONS[name];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  class="shrink-0"
>
  {def.fill && (
    <path
      d={def.fill}
      fill="var(--color-pink-200)"
      fill-opacity="0.55"
    />
  )}
  <path
    d={def.stroke}
    stroke="var(--color-pink-700)"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  {def.accent && (
    <path
      d={def.accent}
      stroke="var(--color-pink-600)"
      stroke-width="1.4"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"
    />
  )}
</svg>
