---
import type { CardMeta } from '../../lib/cards';
import { t } from '../../lib/i18n';
import type { Lang } from '../../lib/types';
import CardIcon from './CardIcon.astro';

interface Props {
  card: CardMeta;
  lang?: Lang;
  /** Degrees. The deck motif fans by a fixed delta so the stack never looks accidental. */
  tilt?: number;
  /** The universal card carries «यह कार्ड सबके लिए है» in the reveal (F-23). */
  universal?: boolean;
  compact?: boolean;
}

const { card, lang = 'hi', tilt = 0, universal = false, compact = false } = Astro.props;
---

{
  /* THE signature element. The card is genuinely the product, it gets printed, put on
 a table, passed around a room of eight women, photographed, forwarded. So it is
 drawn as a physical card, not a content box.

 The tilted-frame motif and the fanned-deck motif are the same component: a pink
 card rotated behind, the face counter-rotated on top. Fixed delta, never random
 inconsistent angles are what make this pattern look accidental. */
}
{
  /* h-full + a min-height is what keeps the deck looking like a DECK. Without it every
 card is as tall as its own summary happens to be, and a row of them reads as
 ragged rather than as a set. The parent gives each cell equal height; this makes
 the card fill it. */
}
<article
  class:list={[
    'group relative isolate flex h-full min-h-60 flex-col transition-transform duration-300',
    compact ? 'w-full' : 'w-[17rem] shrink-0',
  ]}
  data-testid={`haq-card-${card.slug}`}
  style={`--tilt:${tilt}deg`}
>
  {/* the card behind, pure tint, no shadow ramp */}
  <div
    class="absolute inset-0 -z-10 rounded-card bg-pink-200/45"
    style="transform: rotate(var(--tilt))"
    aria-hidden="true"
  >
  </div>

  <a
    href={`/card/${card.slug}`}
    class="flex h-full flex-col gap-3 rounded-card border border-pink-200 bg-surface p-6
text-ink no-underline shadow-[0_2px_6px_rgba(31,42,68,0.04)] transition-all duration-300 hover:-translate-y-1 hover:border-pink-600/40 hover:shadow-[0_18px_36px_-16px_rgba(214,51,108,0.25),0_2px_6px_rgba(31,42,68,0.06)]"
    style="transform: rotate(calc(var(--tilt) * -0.28))"
  >
    <span class="flex items-center justify-between gap-2">
      <CardIcon name={card.icon} />
      {
        universal && (
          <span
            class="rounded-pill bg-green-050 px-2.5 py-1 text-[0.75rem] font-bold text-green-700"
            data-i18n="s7.universal"
          >
            {t('s7.universal', lang)}
          </span>
        )
      }
    </span>

    <h3 class="text-app-title leading-snug font-bold text-ink" data-card-title={card.id}>
      {card.title[lang]}
    </h3>

    <p class="text-[0.9375rem] leading-relaxed text-muted" data-card-summary={card.id}>
      {card.summary[lang]}
    </p>

    <span
      class="mt-auto inline-flex items-center gap-1.5 text-[0.9375rem] font-bold text-pink-700 transition-transform duration-200 group-hover:translate-x-1"
      data-i18n="card.open"
    >
      {t('card.open', lang)}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M5 12h13M13 6l6 6-6 6"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </a>
</article>
