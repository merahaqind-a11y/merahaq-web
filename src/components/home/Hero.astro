---
import { t } from '../../lib/i18n';
import type { Lang } from '../../lib/types';
import HeroDeck from './HeroDeck.astro';

interface Props {
  lang?: Lang;
}
const { lang = 'hi' } = Astro.props;

/**
 * F-10 / F-11 / F-12 / §5.4.
 *
 * Hard requirement: the hero question, the सुनिए control, the primary CTA, the escape
 * link and the helpline strip are all visible WITHOUT SCROLLING at 360×740, in all
 * three languages. Asserted by test, not by eye.
 *
 * The headline is hand-split into word spans for the GSAP reveal. SplitText is
 * deliberately not used — hand-splitting keeps the original text nodes intact for
 * screen readers and for the language switcher, and adds no plugin weight.
 */
const question = t('hero.question', lang);
const words = question.split(' ');

const EMPH: Record<Lang, string> = { hi: 'हक़', hinglish: 'haq', en: 'belong' };
const isEmph = (w: string): boolean =>
  w.toLowerCase().replace(/[?,.]/g, '').includes(EMPH[lang].toLowerCase());
---

<section
  data-section="hero"
  class="relative overflow-hidden bg-bg px-5 pt-8 pb-0"
  aria-labelledby="hero-heading"
>
  <div class="bloom" data-anim="bloom" aria-hidden="true"></div>

  <div
    class="relative mx-auto grid max-w-6xl items-center gap-6 lg:grid-cols-[minmax(0,1.02fr)_minmax(0,0.98fr)]
           lg:gap-12 lg:pt-4"
  >
    <div>
      <h1
        id="hero-heading"
        data-testid="hero-question"
        data-i18n-split="hero.question"
        class="shirorekha text-display leading-[1.12] font-medium text-ink"
        style="--shirorekha-width:5rem"
      >
        {
          words.map((w, i) => (
            <>
              <span class="inline-block overflow-hidden align-bottom">
                <span class:list={['inline-block', isEmph(w) && 'emph']} data-anim="hero-word">
                  {w}
                </span>
              </span>
              {i < words.length - 1 && ' '}
            </>
          ))
        }
      </h1>

      <p class="mt-4 max-w-xl text-lead text-muted" data-i18n="hero.sub">{t('hero.sub', lang)}</p>

      {
        /* सुनिए as a circular play control with its label beside it. For this user
           audio is the primary channel, not an accessibility afterthought — so it
           reads as a play button, which is the one control everyone already knows. */
      }
      <button
        type="button"
        data-testid="sunie"
        data-sunie="hero"
        class="mt-5 inline-flex tap items-center gap-3 rounded-pill border border-blue-600/25
               bg-surface py-1 pe-5 ps-1 font-bold text-blue-600 disabled:border-border disabled:text-muted"
      >
        <span
          class="grid size-11 shrink-0 place-items-center rounded-pill bg-blue-600 text-surface"
          aria-hidden="true"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5.5v13l11-6.5-11-6.5z"></path>
          </svg>
        </span>
        <span data-sunie-label data-i18n="sunie.play">{t('sunie.play', lang)}</span>
        <span class="hidden h-[2px] w-16 bg-blue-600/25" data-sunie-progress aria-hidden="true">
          <span class="block h-full w-0 bg-blue-600"></span>
        </span>
      </button>

      <div class="mt-6 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
        {
          /* THE action. #D6336C appears exactly once on this screen — a test fails the
             build if a second pink-600 action shows up. */
        }
        <a
          href="/shuru"
          data-testid="hero-cta"
          data-anim="hero-cta"
          data-i18n="cta.primary"
          class="flex tap-lg w-full items-center justify-center rounded-action bg-pink-600 px-8
                 text-[1.25rem] font-bold text-surface no-underline sm:w-fit"
        >
          {t('cta.primary', lang)}
        </a>

        {
          /* Never trap anyone in the questionnaire (F-12). Outlined rather than a bare
             text link, so it reads as a real second door rather than fine print. */
        }
        <a
          href="/sabhi-card"
          data-testid="hero-escape"
          data-i18n="cta.allCards"
          class="flex tap-lg w-full items-center justify-center rounded-action border-2 border-ink/15
                 bg-surface px-6 font-bold text-ink no-underline sm:w-fit"
        >
          {t('cta.allCards', lang)}
        </a>
      </div>

      {
        /* Returning visitor with a stored deck (F-14). Hidden in the static HTML and
           revealed client-side, so the page the server sends is identical for everyone
           and nothing about her is baked into it. */
      }
      <a
        href="/aapke-card"
        data-testid="hero-mycards"
        data-i18n="cta.myCards"
        hidden
        class="mt-3 tap w-fit items-center font-bold text-pink-700 underline underline-offset-4"
      >
        {t('cta.myCards', lang)}
      </a>
    </div>

    <HeroDeck lang={lang} />
  </div>
</section>
