---
import { t } from '../../lib/i18n';
import type { Lang } from '../../lib/types';
import HeroDeck from './HeroDeck.astro';

interface Props {
  lang?: Lang;
}
const { lang = 'hi' } = Astro.props;

/**
 * F-10 / F-11 / F-12 / §5.4.
 *
 * Single CTA hero. The सुनिए control and «सारे कार्ड देखें» exit have been removed
 * from the hero at owner request; both remain reachable from the header nav and the
 * card page chrome, so the safety and audio channels are not lost, only relocated.
 */
const question = t('hero.question', lang);
const words = question.split(' ');

const EMPH: Record<Lang, string> = { hi: 'हक़', hinglish: 'haq', en: 'hands' };
const isEmph = (w: string): boolean =>
  w.toLowerCase().replace(/[?,.]/g, '').includes(EMPH[lang].toLowerCase());
---

{
  /* Full-bleed hero: pink-050 solid all the way to the left edge, image full-height on
   the right, touching the header at the top. */
}
<section
  data-section="hero"
  class="relative overflow-hidden bg-pink-050 pb-8 sm:pb-10 lg:pb-0"
  aria-labelledby="hero-heading"
>
  {/* Deliberate solid pink band along the whole left half. It sits BEHIND the image
   column and extends further right than the image itself, so any imperfection in
   the wipe reveal shows pink rather than the base grey. */}
  <div
    class="pointer-events-none absolute inset-y-0 left-0 hidden bg-pink-050 lg:block lg:w-[62%]"
    aria-hidden="true"
  >
  </div>

  <div class="bloom" data-anim="bloom" aria-hidden="true"></div>

  <div
    class="relative mx-auto grid max-w-[100rem] items-stretch gap-0 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)]"
  >
    <div class="px-5 pt-14 sm:px-8 sm:pt-20 lg:pt-32 lg:pb-8 lg:ps-10 lg:pe-6 lg:mx-auto lg:max-w-[38rem]">
      <h1
        id="hero-heading"
        data-testid="hero-question"
        data-i18n-split="hero.question"
        class="text-display leading-[1.12] font-medium tracking-tight text-ink"
      >
        {
          words.map((w, i) => (
            <>
              <span class="inline-block overflow-hidden align-bottom">
                <span class:list={['inline-block', isEmph(w) && 'emph']} data-anim="hero-word">
                  {w}
                </span>
              </span>
              {i < words.length - 1 && ' '}
            </>
          ))
        }
      </h1>

      <p class="mt-5 max-w-xl text-lead leading-relaxed text-muted" data-testid="hero-sub" data-i18n="hero.sub">{t('hero.sub', lang)}</p>

      <div class="mt-10">
        <a
          href="/shuru"
          data-testid="hero-cta"
          data-anim="hero-cta"
          data-i18n="cta.primary"
          class="inline-flex tap-lg items-center justify-center rounded-action bg-pink-600 px-10
text-[1.25rem] font-bold whitespace-nowrap text-surface no-underline shadow-[0_8px_20px_-6px_rgba(214,51,108,0.55)] transition-transform duration-200 hover:-translate-y-0.5 hover:bg-pink-700 active:translate-y-0"
        >
          {t('cta.primary', lang)}
        </a>
      </div>
    </div>

    <div class="relative lg:h-full">
      <HeroDeck lang={lang} />
    </div>
  </div>
</section>
