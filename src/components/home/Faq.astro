---
import Section from './Section.astro';
import { t } from '../../lib/i18n';
import type { Lang } from '../../lib/types';

interface Props {
  lang?: Lang;
}
const { lang = 'hi' } = Astro.props;

const QUESTIONS = [1, 2, 3, 4, 5, 6] as const;

// Native <details>, so the answers are readable with JavaScript disabled — the same
// discipline that keeps the card pages and /madad working when the bundle never loads.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: QUESTIONS.map((n) => ({
    '@type': 'Question',
    name: t(`faq.${n}.q`, lang),
    acceptedAnswer: { '@type': 'Answer', text: t(`faq.${n}.a`, lang) },
  })),
};
---

<Section id="faq" headingKey="faq.heading" lang={lang} tint>
  <div class="max-w-3xl">
    {
      QUESTIONS.map((n, i) => (
        <details
          class:list={['group border-border py-1', i > 0 && 'border-t']}
          data-testid={`faq-${n}`}
        >
          <summary
            class="flex tap-lg cursor-pointer list-none items-center justify-between gap-4
                   text-app-title font-bold text-ink [&::-webkit-details-marker]:hidden"
            data-i18n={`faq.${n}.q`}
          >
            {t(`faq.${n}.q`, lang)}
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              class="shrink-0 text-pink-700 transition-transform group-open:rotate-45"
            >
              <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
            </svg>
          </summary>
          <p class="pb-5 text-muted" data-i18n={`faq.${n}.a`}>
            {t(`faq.${n}.a`, lang)}
          </p>
        </details>
      ))
    }
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Section>
