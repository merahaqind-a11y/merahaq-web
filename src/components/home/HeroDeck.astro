---
import type { Lang } from '../../lib/types';

interface Props {
  lang?: Lang;
}
const { lang: _lang = 'hi' } = Astro.props;
---

{
  /* Full-bleed image on the right. On lg+ it fills 100% of the hero height and touches
   the header/helpline strip at the top with zero gap. Below lg it renders as a normal
   contained rounded photo below the actions.

   The reveal — GSAP animates clip-path from `inset(0 100% 0 0)` → `inset(0 0 0 0)`
   so the image "opens" from LEFT to RIGHT: the leftmost part of the image appears
   first, growing rightward. During the animation the un-revealed right area shows the
   section's pink-050 background (which sits behind), so no grey is ever visible.

   Two blend layers on the left, stacked, make the image feel like it's PART of the
   section rather than pasted on top of it:
     · a wide gradient from pink-050 → transparent over the leftmost ~35% of the image
     · a narrow feathered edge (pink-050 → transparent) right at the boundary */
}
<div class="relative w-full lg:h-full" data-testid="hero-art">
  <div
    class="relative h-64 overflow-hidden sm:h-80 lg:h-full lg:min-h-[42rem]"
    data-anim="hero-photo"
    style="clip-path: inset(0 0 0 0)"
  >
    <img
      src="/images/hero-women.webp"
      width="1600"
      height="1200"
      alt=""
      aria-hidden="true"
      class="block h-full w-full object-cover object-center"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />

    {/* Wide primary blend — pink-050 fades to transparent across the leftmost portion
       of the image. This is what does the heavy lifting on the "blend" feel. */}
    <div
      class="pointer-events-none absolute inset-y-0 left-0 hidden w-[45%] bg-gradient-to-r from-pink-050 via-pink-050/60 to-transparent lg:block"
      aria-hidden="true"
    >
    </div>

    {/* Feathered edge right at the boundary — a narrow, dense pink-050 strip that
       kills any hard vertical line where the image starts. */}
    <div
      class="pointer-events-none absolute inset-y-0 left-0 hidden w-24 bg-gradient-to-r from-pink-050 to-pink-050/0 lg:block"
      aria-hidden="true"
    >
    </div>
  </div>
</div>
