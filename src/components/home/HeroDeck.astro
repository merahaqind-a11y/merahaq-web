---
import { CARDS } from '../../lib/cards';
import CardIcon from '../card/CardIcon.astro';
import Logo from '../chrome/Logo.astro';
import { t } from '../../lib/i18n';
import type { Lang } from '../../lib/types';

interface Props {
  lang?: Lang;
}
const { lang = 'hi' } = Astro.props;

/**
 * The hero artwork: the brand mark, large, with one Haq Card floating over it.
 *
 * There is deliberately no photograph. Stock imagery of Indian women is both the
 * generic-NGO cliché and a genuine risk on a product where distress imagery is
 * forbidden, and any real face invites the reader to decide whether this is "for
 * someone like her". The brand mark carries the warmth without making that claim,
 * and it is already the product's own drawing rather than a purchased one.
 *
 * The floating card is the same component that appears everywhere else. It shows what
 * the product actually hands her, in the first screen, before she taps anything.
 */
const TOP = CARDS.C1;
---

<div class="relative mx-auto w-full max-w-[21rem] pb-12 lg:max-w-[29rem]" data-testid="hero-art">
  {
    /* The mark, set back and offset right so the card can overlap its lower-left without
 covering the face. Sized so the card still clears the fold at 360×740. */
  }
  <div class="relative ms-auto w-[64%] opacity-95 lg:w-[72%]" data-anim="hero-mark">
    <Logo variant="mark" />
  </div>

  {/* one card, floating over it */}
  <div
    class="absolute inset-x-0 bottom-10 mx-auto w-[94%] sm:w-[88%] lg:bottom-8"
    data-anim="deck-face"
  >
    <div class="relative">
      {/* two behind, wider than the face so the rotation actually shows */}
      <div
        class="absolute inset-x-0 top-2 h-full rounded-card border border-pink-200/70 bg-pink-200/25"
        style="transform: rotate(-4.5deg)"
        data-anim="deck-back"
        aria-hidden="true"
      >
      </div>
      <div
        class="absolute inset-x-0 top-2 h-full rounded-card border border-pink-200/70 bg-pink-200/40"
        style="transform: rotate(4.5deg)"
        data-anim="deck-back"
        aria-hidden="true"
      >
      </div>

      <a
        href={`/card/${TOP.slug}`}
        class="relative flex flex-col gap-2 rounded-card border border-pink-200 bg-surface/92 p-5
 text-ink no-underline shadow-[0_10px_30px_rgb(31_42_68/0.10)] backdrop-blur-sm"
      >
        <CardIcon name={TOP.icon} />
        <h2 class="text-app-title leading-snug font-bold text-ink" data-card-title={TOP.id}>
          {TOP.title[lang]}
        </h2>
        <p class="text-[0.9375rem] leading-relaxed text-muted" data-card-summary={TOP.id}>
          {TOP.summary[lang]}
        </p>
      </a>
    </div>
  </div>

  {/* «1 / 10 कार्ड», tells her the deck has a size before she commits to anything */}
  <p class="mono absolute inset-x-0 bottom-0 text-center text-[0.875rem] text-muted">
    <span class="font-bold text-ink">1</span> / 10
    <span data-i18n="gallery.counter"> {t('gallery.counter', lang)}</span>
  </p>
</div>
