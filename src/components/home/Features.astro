---
import Section from './Section.astro';
import { t } from '../../lib/i18n';
import type { Lang } from '../../lib/types';

interface Props {
  lang?: Lang;
}
const { lang = 'hi' } = Astro.props;

// Outline icons, drawn inline. No icon font, no emoji — emoji render differently on
// every Android skin and a screen reader announces them as their CLDR name.
const FEATURES = [
  { key: 'audio', d: 'M4 9v6h4l5 4V5L8 9H4zM17 8.5a5 5 0 010 7M20 6a9 9 0 010 12' },
  { key: 'share', d: 'M4 12v7a1 1 0 001 1h14a1 1 0 001-1v-7M12 15V3M8 7l4-4 4 4' },
  { key: 'print', d: 'M7 8V3h10v5M7 18H5a1 1 0 01-1-1v-5a2 2 0 012-2h12a2 2 0 012 2v5a1 1 0 01-1 1h-2M7 14h10v7H7v-7z' },
  { key: 'offline', d: 'M5 18h11a4 4 0 000-8 6 6 0 00-11.3 2A3.5 3.5 0 005 18zM3 3l18 18' },
  { key: 'lang', d: 'M4 6h9M8 4v2c0 4-2 7-5 9M7 12c2 3 4 4 7 5M13 20l4-9 4 9M14.8 17h4.4' },
  { key: 'exit', d: 'M14 4h4a2 2 0 012 2v12a2 2 0 01-2 2h-4M10 8l-4 4 4 4M6 12h10' },
] as const;
---

<Section id="features" headingKey="features.heading" lang={lang}>
  <ul class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
    {
      FEATURES.map(({ key, d }) => (
        <li data-anim="feature">
          <span
            class="grid size-11 place-items-center rounded-action bg-pink-050 text-pink-700"
            aria-hidden="true"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <path
                d={d}
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <h3 class="mt-4 text-app-title font-bold text-ink" data-i18n={`features.${key}.title`}>
            {t(`features.${key}.title`, lang)}
          </h3>
          <p class="mt-2 text-muted" data-i18n={`features.${key}.body`}>
            {t(`features.${key}.body`, lang)}
          </p>
        </li>
      ))
    }
  </ul>
</Section>
