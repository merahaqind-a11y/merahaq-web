---
import Section from './Section.astro';
import HaqCard from '../card/HaqCard.astro';
import { CARD_LIST } from '../../lib/cards';
import type { Lang } from '../../lib/types';

interface Props {
  lang?: Lang;
}
const { lang = 'hi' } = Astro.props;
---

{
  /* Pin 2 of 2, and the signature moment: above 768px GSAP pins this section and scrubs
 the track horizontally as she scrolls vertically. Below 768px it stays exactly what
 it is here, a native scroll-snap scroller. Pinned horizontal scroll janks badly on
 a ₹7k Android, and this audience IS that device.

 All ten are here and reachable regardless. Personalisation curates the deck; it
 never censors the library. */
}
<Section id="cards" headingKey="gallery.heading" subKey="gallery.sub" lang={lang} tint>
  <div class="-mx-5 overflow-x-auto px-5 pb-4 [scrollbar-width:thin] lg:overflow-hidden">
    <ul class="flex snap-x snap-mandatory gap-4 lg:snap-none" data-anim="gallery-track">
      {
        CARD_LIST.map((card) => (
          <li class="snap-start">
            <HaqCard card={card} lang={lang} tilt={0} universal={card.role === 'universal'} />
          </li>
        ))
      }
    </ul>
  </div>
</Section>
