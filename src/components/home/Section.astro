---
import type { Lang } from '../../lib/types';
import { t } from '../../lib/i18n';

interface Props {
  id: string;
  headingKey: string;
  subKey?: string;
  lang?: Lang;
  /** The one dark chapter. Exactly one section on the page may set this. */
  dark?: boolean;
  tint?: boolean;
  /** Renders the giant rounded sheet corners where a light sheet meets the dark chapter. */
  sheet?: boolean;
  class?: string;
}

const {
  id,
  headingKey,
  subKey,
  lang = 'hi',
  dark = false,
  tint = false,
  sheet = false,
  class: cls = '',
} = Astro.props;
---

{
  /* Flat hierarchy by design: every section heading is the same size. No section
 outranks another, appropriate for a product where each route is equally valid.
 Hierarchy below this level is carried by weight and colour, never by size.

 One rhythm scale across the whole home page: 96px on phones, 128px on tablets,
 160px on desktop. Even every-section spacing is what makes the page feel
 composed rather than assembled. */
}
<section
  data-section={id}
  class:list={[
    'relative px-5 py-14 sm:px-8 sm:py-16 lg:px-10 lg:py-20',
    dark && 'bg-ink text-surface',
    tint && !dark && 'bg-pink-050',
    !dark && !tint && 'bg-surface',
    sheet && 'rounded-t-[var(--radius-sheet)]',
    cls,
  ]}
  aria-labelledby={`${id}-heading`}
>
  <div class="mx-auto max-w-6xl">
    <h2
      id={`${id}-heading`}
      class:list={[
        'text-section leading-tight font-bold tracking-tight',
        dark ? 'text-surface' : 'text-ink',
      ]}
      data-i18n={headingKey}
      data-anim="section-heading"
    >
      {t(headingKey, lang)}
    </h2>

    {
      subKey && (
        <p
          class:list={['mt-4 max-w-2xl text-lead leading-relaxed', dark ? 'text-surface/80' : 'text-muted']}
          data-i18n={subKey}
        >
          {t(subKey, lang)}
        </p>
      )
    }

    <div class="mt-10 sm:mt-12 lg:mt-14">
      <slot />
    </div>
  </div>
</section>
