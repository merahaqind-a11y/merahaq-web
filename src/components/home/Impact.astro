---
import Section from './Section.astro';
import { t } from '../../lib/i18n';
import type { Lang } from '../../lib/types';

interface Props {
  lang?: Lang;
}
const { lang = 'hi' } = Astro.props;

/**
 * The ONE dark chapter. Polarity inversion as a chapter marker, the reader knows a new
 * argument has begun because the world changed colour, not because a divider appeared.
 *
 * THE NUMBERS ARE EM DASHES ON PURPOSE. The PRD forbids invented numbers and no pilot
 * session has run. A placeholder that says «» and explains why is honest; a plausible
 * number is a lie that gets quoted back at you. When real counts exist, set `value` and
 * the GSAP count-up animates them.
 */
const STATS: { key: string; value: number | null }[] = [
  { key: 'impact.1', value: null },
  { key: 'impact.2', value: null },
  { key: 'impact.3', value: null },
  { key: 'impact.4', value: null },
  { key: 'impact.5', value: null },
];
---

<Section id="impact" headingKey="impact.heading" subKey="impact.sub" lang={lang} dark>
  <dl class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {
      STATS.map(({ key, value }) => (
        <div class="border-t border-surface/15 pt-5">
          {
            /* `data-to` stays EMPTY for a placeholder. The GSAP count-up keys off it,
             and animating «अभी नहीं» to zero would invent the number this page exists
             to refuse to invent. The placeholder is also set smaller, because it is a
             phrase and not a figure. */
          }
          <dd
            class:list={[
              'mono leading-none font-bold text-pink-200',
              value === null ? 'text-[1.5rem]' : 'text-stat',
            ]}
            data-anim="stat"
            data-to={value ?? ''}
          >
            {value ?? t('impact.notYet', lang)}
          </dd>
          <dt class="mt-3 text-surface/80" data-i18n={key}>
            {t(key, lang)}
          </dt>
        </div>
      ))
    }
  </dl>

  <p class="mt-10 max-w-2xl text-surface/70" data-i18n="impact.pending">
    {t('impact.pending', lang)}
  </p>

  {
    /* «जो काम नहीं आया», publishing what failed is not a footnote here, it is the
 brand. An impact page that only reports wins stops being a record and starts
 being a pitch. */
  }
  <div class="mt-12 border-s-[3px] border-pink-200 ps-5">
    <h3 class="text-app-title font-bold text-surface" data-i18n="impact.failures">
      {t('impact.failures', lang)}
    </h3>
    <p class="mt-2 max-w-2xl text-surface/80" data-i18n="impact.failuresBody">
      {t('impact.failuresBody', lang)}
    </p>
  </div>

  <p class="mono mt-8 text-[0.9375rem] text-surface/60" data-i18n="impact.method">
    {t('impact.method', lang)}
  </p>
</Section>
