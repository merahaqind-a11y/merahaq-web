---
import { t } from '../../lib/i18n';
import type { Lang } from '../../lib/types';

interface Props {
  lang?: Lang;
}
const { lang = 'hi' } = Astro.props;

/**
 * F-03. Visible without scrolling on the home screen (§5.4 r6).
 *
 * Someone may arrive here in the worst hour of her life. The number must not require a
 * journey — no scroll, no menu, no tap to reveal. Numbers are mono because a numeral in
 * mono reads as "this is a number you can act on" before it is read.
 *
 * 181   Mahila Helpline, 24×7, connects to the One Stop Centre
 * 15100 NALSA free legal aid — the number that makes «muft vakil» real
 */
const NUMBERS = ['181', '15100'] as const;
---

<div class="bg-blue-050" data-testid="helpline-strip" role="group" aria-label={t('madad.universal', lang)}>
  <div class="mx-auto flex max-w-6xl items-stretch gap-2 px-3 py-2 sm:justify-start">
    {
      NUMBERS.map((n) => (
        <a
          href={`tel:${n}`}
          data-testid={`tel-${n}`}
          class="tap-lg flex flex-1 flex-col items-center justify-center rounded-action border
                 border-blue-600/25 bg-surface px-3 py-1 leading-tight text-blue-600 no-underline
                 sm:max-w-56 sm:flex-none sm:flex-row sm:items-baseline sm:gap-2"
        >
          <span class="mono text-[1.25rem] font-bold tracking-tight">{n}</span>
          <span class="text-[0.8125rem] text-muted" data-i18n={`helpline.${n}`}>
            {t(`helpline.${n}`, lang)}
          </span>
        </a>
      ))
    }
  </div>
</div>
