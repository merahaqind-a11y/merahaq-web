---
import { t, LANGS } from '../../lib/i18n';
import type { Lang } from '../../lib/types';
import MenuOverlay from './MenuOverlay.astro';
import Logo from './Logo.astro';
import QuickExit from './QuickExit.astro';
import HelplineTicker from './HelplineTicker.astro';

interface Props {
  lang?: Lang;
  /** Home and institutional routes only. Never on app routes, login is never
   * required for anything and must not crowd the two safety controls. */
  showLogin?: boolean;
}
const { lang = 'hi', showLogin = false } = Astro.props;

const SHORT: Record<Lang, string> = { hi: 'हिं', hinglish: 'Hg', en: 'EN' };

/**
 * The rights routes, shown inline on desktop and inside ☰ on phones.
 *
 * Short labels, not the menu's fuller wording. A header nav is scanned, not read:
 * «असर» does the job that «असर, अब तक क्या हुआ» does inside the overlay, where there
 * is room for a sentence.
 */
const NAV = [
  { key: 'nav.diagnostic', href: '/shuru' },
  { key: 'nav.allCards', href: '/sabhi-card' },
  { key: 'nav.madad', href: '/madad' },
  { key: 'nav.about', href: '/hamare-baare-mein' },
  { key: 'nav.impact', href: '/asar' },
] as const;
---

{
  /* Language bar, above everything. Language is the first decision on the page, so it
   sits above the masthead rather than competing for room inside it.

   Slightly taller than a raw pill (py-2) so the whole strip has real breathing room and
   the pill has a bed of dark ink around it — the strip reads as chrome, not as a control
   that got squeezed into a slot. Every pixel here is still a pixel the question below
   does not get, so the pill itself stays compact. */
}
<div class="sticky top-0 z-70 bg-ink" data-testid="topbar">
  <div class="mx-auto flex max-w-6xl items-center justify-center px-4 py-2 sm:px-6">
    <div
      class="flex items-center gap-1 rounded-pill bg-surface/[0.08] p-1 ring-1 ring-surface/10"
      data-testid="lang-pill"
      role="group"
      aria-label={t('lang.label', lang)}
    >
      {
        LANGS.map((l) => (
          <button
            type="button"
            data-lang={l}
            data-testid={`lang-${l}`}
            aria-pressed={l === lang ? 'true' : 'false'}
            class="grid min-h-9 min-w-11 place-items-center rounded-pill px-4 text-[0.8125rem] font-bold whitespace-nowrap text-surface/75 transition-colors duration-200 hover:text-surface aria-pressed:bg-surface aria-pressed:text-ink aria-pressed:shadow-[0_1px_0_0_rgba(31,42,68,0.08)]"
          >
            <span class="hidden sm:inline" data-i18n={`lang.${l}`}>
              {t(`lang.${l}`, lang)}
            </span>
            <span class="sm:hidden">{SHORT[l]}</span>
          </button>
        ))
      }
    </div>
  </div>
</div>

{/* ── masthead ─────────────────────────────────────────────────────────────── */}
{
  /* z-60 puts the masthead ABOVE the menu overlay (z-50), not below it. That is not a
 styling preference: the quick exit lives in this row, and §5.5 r5 requires it to
 keep working while the menu is open. At z-40 the overlay covered it and the tap
 landed on a menu link instead, the panic control was dead exactly when the menu
 was in the way. The menu now fills the space beneath the masthead. */
}
{
  /* Sticks BELOW the language bar (top-13 = its ~52px height with py-2), so the whole
   chrome stack holds together as one unit instead of the dark bar sliding up behind
   the masthead and leaving a moving sliver at the top of the viewport. */
}
<header
  class="sticky top-13 z-60 border-b border-border/70 bg-surface/95 backdrop-blur-md supports-[not(backdrop-filter:blur(0))]:bg-surface"
  data-testid="header"
>
  <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3.5 sm:px-6 sm:gap-5 lg:py-4">
    <Logo />

    {
      /* Phones get ☰; from lg up the same routes are simply visible, because there is
 room and a menu you have to open is a menu you might not. */
    }
    <button
      type="button"
      data-testid="menu-toggle"
      aria-label={t('menu.open', lang)}
      aria-expanded="false"
      aria-controls="mh-menu"
      class="grid tap shrink-0 place-items-center rounded-action text-ink transition-colors duration-200 hover:bg-bg lg:hidden"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M4 7h16M4 12h16M4 17h16"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"></path>
      </svg>
    </button>

    <nav class="hidden flex-1 lg:block" aria-label={t('menu.open', lang)} data-testid="desktop-nav">
      <ul class="flex items-center justify-center gap-0.5">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                data-testid={`nav-${item.key.split('.')[1]}`}
                class="flex tap relative items-center rounded-action px-3.5 text-[0.9375rem] font-semibold whitespace-nowrap text-ink/85 no-underline transition-colors duration-200 hover:text-ink hover:bg-pink-050"
                data-i18n={item.key}
              >
                {t(item.key, lang)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ms-auto flex shrink-0 items-center gap-2 sm:gap-3">
      {
        showLogin && (
          <a
            href="/login"
            data-testid="login-header"
            class="hidden tap items-center gap-2 rounded-action px-3 text-[0.9375rem] font-semibold
whitespace-nowrap text-ink/85 no-underline transition-colors duration-200 hover:text-ink hover:bg-bg sm:inline-flex"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M12 12a4 4 0 100-8 4 4 0 000 8zM4.5 20a7.5 7.5 0 0115 0"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              />
            </svg>
            <span data-i18n="login.header">{t('login.header', lang)}</span>
          </a>
        )
      }
      {/* Quick-exit removed from visible chrome at owner request (Shift+Esc keyboard escape still active via QuickExit's inline script for facilitator demos). */}
      <QuickExit />
    </div>
  </div>
</header>

<HelplineTicker lang={lang} />

<MenuOverlay lang={lang} />

<script>
  import { initLang } from '../../lib/lang';
  import { readPrefs, writePrefs, clearPrefs, hasDeck } from '../../lib/prefs';

  initLang();

  const menu = document.getElementById('mh-menu');
  const toggle = document.querySelector<HTMLButtonElement>('[data-testid="menu-toggle"]');

  /**
   * Deactivate the page behind a modal, but NEVER the quick exit. §5.5 r5 is explicit
   * that ✘ keeps working while the menu is up.
   *
   * `inert` is INHERITED, so inerting <header> would kill the exit that now lives
   * inside it, and setting inert=false on a descendant does not bring it back. So the
   * header's siblings are inerted individually and the exit's shell is left alone.
   * A test drives this: open the menu, tap ✘, expect to leave the site.
   */
  const INERT_TARGETS = [
    'main',
    'footer',
    '[data-testid="topbar"]',
    '[data-testid="logo"]',
    '[data-testid="menu-toggle"]',
    '[data-testid="desktop-nav"]',
    '[data-testid="login-header"]',
  ];

  function setBackgroundInert(on: boolean): void {
    for (const sel of INERT_TARGETS) {
      for (const el of Array.from(document.querySelectorAll<HTMLElement>(sel))) el.inert = on;
    }
    document.body.style.overflow = on ? 'hidden' : '';
  }

  function openMenu(open: boolean): void {
    if (!menu || !toggle) return;
    menu.hidden = !open;
    menu.classList.toggle('hidden', !open);
    menu.classList.toggle('block', open);
    toggle.setAttribute('aria-expanded', String(open));
    setBackgroundInert(open);
    if (open) menu.querySelector<HTMLElement>('[data-menu-close]')?.focus();
    else toggle.focus();
  }

  toggle?.addEventListener('click', () => openMenu(menu?.hidden ?? true));
  menu?.querySelector('[data-menu-close]')?.addEventListener('click', () => openMenu(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !e.shiftKey && menu && !menu.hidden) openMenu(false);
  });

  if (hasDeck()) {
    for (const li of Array.from(document.querySelectorAll<HTMLElement>('[data-deck-only]'))) {
      li.hidden = false;
    }
  }

  const muteBtn = document.querySelector<HTMLButtonElement>('[data-menu-mute]');
  function paintMute(): void {
    muteBtn?.setAttribute('aria-pressed', String(readPrefs().muted));
  }
  paintMute();
  muteBtn?.addEventListener('click', () => {
    writePrefs({ muted: !readPrefs().muted });
    paintMute();
    document.dispatchEvent(new CustomEvent('mh:mutechange'));
  });

  const confirmEl = document.querySelector<HTMLElement>('[data-reset-confirm]');
  function showConfirm(open: boolean): void {
    if (!confirmEl) return;
    confirmEl.hidden = !open;
    confirmEl.classList.toggle('hidden', !open);
    confirmEl.classList.toggle('grid', open);
    if (menu) menu.inert = open;
    setBackgroundInert(true);
    if (open) confirmEl.querySelector<HTMLElement>('[data-reset-no]')?.focus();
  }
  document.querySelector('[data-menu-reset]')?.addEventListener('click', () => showConfirm(true));
  document.querySelector('[data-reset-no]')?.addEventListener('click', () => showConfirm(false));
  document.querySelector('[data-reset-yes]')?.addEventListener('click', () => {
    const lang = readPrefs().lang;
    clearPrefs();
    writePrefs({ lang }); // her language choice is a preference, not part of the deck
    location.href = '/shuru';
  });
</script>
