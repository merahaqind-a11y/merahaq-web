---
import { t, LANGS } from '../../lib/i18n';
import type { Lang } from '../../lib/types';
import MenuOverlay from './MenuOverlay.astro';
import Logo from './Logo.astro';

interface Props {
  lang?: Lang;
  /** Home and institutional routes only. Never on app routes — it would crowd the
   *  two fixed safety controls, and login is never required for anything. */
  showLogin?: boolean;
}
const { lang = 'hi', showLogin = false } = Astro.props;

const SHORT: Record<Lang, string> = { hi: 'हिं', hinglish: 'Hg', en: 'EN' };
---

{
  /* ☰ top-left · language pill top-centre · ✘ top-right (rendered by Base).
     These three never move and never swap, on any screen (PRD §5.5 r1). The header
     sits below the quick exit in the stacking order so the exit stays tappable while
     the menu overlay is open. */
}
<header
  class="sticky top-0 z-40 border-b border-border bg-surface/85 backdrop-blur-md
         supports-[not(backdrop-filter:blur(0))]:bg-surface"
  data-testid="header"
>
  <div class="mx-auto flex max-w-6xl items-center gap-2 px-3 py-2">
    <Logo />

    <button
      type="button"
      data-testid="menu-toggle"
      aria-label={t('menu.open', lang)}
      aria-expanded="false"
      aria-controls="mh-menu"
      class="grid tap shrink-0 place-items-center rounded-action text-ink"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M4 7h16M4 12h16M4 17h16"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"></path>
      </svg>
    </button>

  {
    /* Language is a first decision, not a settings-menu item — hence top-centre and
       not inside ☰. Positioned so it never competes with the two safety controls. */
  }
    {
      /* Full language names, not two-letter codes. «हिं / Hg / EN» asks a woman who
         reads slowly to decode an abbreviation before she can even choose how to read
         the page. The short form only appears where there is genuinely no room. */
    }
    <div
      class="mx-auto flex items-center gap-1 rounded-pill bg-bg p-1"
      data-testid="lang-pill"
      role="group"
      aria-label={t('lang.label', lang)}
    >
      {
        LANGS.map((l) => (
          <button
            type="button"
            data-lang={l}
            data-testid={`lang-${l}`}
            aria-pressed={l === lang ? 'true' : 'false'}
            class="min-h-12 rounded-pill px-3 text-[0.9375rem] font-bold whitespace-nowrap text-muted
                   aria-pressed:bg-surface aria-pressed:text-ink aria-pressed:shadow-header"
          >
            <span class="hidden sm:inline" data-i18n={`lang.${l}`}>
              {t(`lang.${l}`, lang)}
            </span>
            <span class="sm:hidden">{SHORT[l]}</span>
          </button>
        ))
      }
    </div>

  {
    /* Login is hidden below `sm` and surfaced in the ☰ menu instead. On a 360px header
       there is room for exactly three things, and the owner override is explicit that
       Login must never displace the two fixed safety controls. The spacer holds the
       language pill optically centred against the quick exit, which is fixed-positioned
       and therefore outside this flex row. */
  }
    <div class="flex w-12 shrink-0 justify-end sm:w-auto">
      {
        showLogin && (
          <a
            href="/login"
            data-testid="login-header"
            class="me-14 hidden tap shrink-0 items-center gap-2 rounded-action px-3 text-[0.9375rem]
                   font-bold whitespace-nowrap text-ink no-underline sm:inline-flex"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M12 12a4 4 0 100-8 4 4 0 000 8zM4.5 20a7.5 7.5 0 0115 0"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"></path>
            </svg>
            <span data-i18n="login.header">{t('login.header', lang)}</span>
          </a>
        )
      }
    </div>
  </div>
</header>

<MenuOverlay lang={lang} />

<script>
  import { initLang } from '../../lib/lang';
  import { readPrefs, writePrefs, clearPrefs, hasDeck } from '../../lib/prefs';

  // ── language pill ───────────────────────────────────────────────────────────
  initLang();

  // ── menu overlay ────────────────────────────────────────────────────────────
  const menu = document.getElementById('mh-menu');
  const toggle = document.querySelector<HTMLButtonElement>('[data-testid="menu-toggle"]');

  /**
   * Deactivate the page behind a modal — but NEVER the quick exit. It lives in its own
   * rail outside <main>, precisely so it stays reachable while anything is open. §5.5 r5
   * is explicit that ✘ keeps working while the menu is up.
   */
  function setBackgroundInert(on: boolean): void {
    for (const sel of ['header', 'main', 'footer']) {
      const el = document.querySelector<HTMLElement>(sel);
      if (el) el.inert = on;
    }
    document.body.style.overflow = on ? 'hidden' : '';
  }

  function openMenu(open: boolean): void {
    if (!menu || !toggle) return;
    menu.hidden = !open;
    menu.classList.toggle('hidden', !open);
    menu.classList.toggle('block', open);
    toggle.setAttribute('aria-expanded', String(open));
    setBackgroundInert(open);
    if (open) menu.querySelector<HTMLElement>('[data-menu-close]')?.focus();
    else toggle.focus();
  }

  toggle?.addEventListener('click', () => openMenu(menu?.hidden ?? true));
  menu?.querySelector('[data-menu-close]')?.addEventListener('click', () => openMenu(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !e.shiftKey && menu && !menu.hidden) openMenu(false);
  });

  // Deck-only rows (आपके कार्ड, सवाल दोबारा करें) appear only once a deck exists, so
  // the menu a first-time visitor sees is identical to everyone else's.
  if (hasDeck()) {
    for (const li of Array.from(document.querySelectorAll<HTMLElement>('[data-deck-only]'))) {
      li.hidden = false;
    }
  }

  // ── mute (F-06) ─────────────────────────────────────────────────────────────
  const muteBtn = document.querySelector<HTMLButtonElement>('[data-menu-mute]');
  function paintMute(): void {
    muteBtn?.setAttribute('aria-pressed', String(readPrefs().muted));
  }
  paintMute();
  muteBtn?.addEventListener('click', () => {
    writePrefs({ muted: !readPrefs().muted });
    paintMute();
    document.dispatchEvent(new CustomEvent('mh:mutechange'));
  });

  // ── reset (§5.5 r4 — confirms first) ────────────────────────────────────────
  const confirmEl = document.querySelector<HTMLElement>('[data-reset-confirm]');
  function showConfirm(open: boolean): void {
    if (!confirmEl) return;
    confirmEl.hidden = !open;
    confirmEl.classList.toggle('hidden', !open);
    confirmEl.classList.toggle('grid', open);
    // The confirm opens on top of the menu, so the menu is deactivated too — but the
    // quick exit, in its own rail, is not.
    if (menu) menu.inert = open;
    setBackgroundInert(true);
    if (open) confirmEl.querySelector<HTMLElement>('[data-reset-no]')?.focus();
  }
  document.querySelector('[data-menu-reset]')?.addEventListener('click', () => showConfirm(true));
  document.querySelector('[data-reset-no]')?.addEventListener('click', () => showConfirm(false));
  document.querySelector('[data-reset-yes]')?.addEventListener('click', () => {
    const lang = readPrefs().lang;
    clearPrefs();
    writePrefs({ lang }); // her language choice is a preference, not part of the deck
    location.href = '/shuru';
  });
</script>
