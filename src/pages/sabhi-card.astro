---
import Base from '../layouts/Base.astro';
import Header from '../components/chrome/Header.astro';
import HelplineStrip from '../components/chrome/HelplineStrip.astro';
import DraftBanner from '../components/chrome/DraftBanner.astro';
import HaqCard from '../components/card/HaqCard.astro';
import { CARD_LIST } from '../lib/cards';
import { t } from '../lib/i18n';

const lang = 'hi' as const;
---

{
  /* Fully static, zero hydration. All ten cards, always — personalisation curates the
     deck, it never censors the library. This is also the escape hatch from every
     entry point to the diagnostic: nobody is ever trapped in the questionnaire. */
}
<Base title="सबसे ज़रूरी हक़ — मेरा हक़" lang={lang} rights>
  <Header lang={lang} />
  <HelplineStrip lang={lang} />
  <DraftBanner lang={lang} />

  <main id="main" class="relative overflow-hidden px-5 pt-10 pb-16">
    <div class="bloom" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl">
      <h1
        class="shirorekha text-section leading-tight font-bold text-ink"
        style="--shirorekha-width:3.5rem"
        data-i18n="gallery.heading"
      >
        {t('gallery.heading', lang)}
      </h1>
      <p class="mt-3 max-w-2xl text-lead text-muted" data-i18n="gallery.sub">
        {t('gallery.sub', lang)}
      </p>

      {/* Equal-height grid. Card heights are set by the grid row, never by how long a
          particular summary happens to be. */}
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          CARD_LIST.map((card) => (
            <li class="flex">
              <HaqCard card={card} lang={lang} universal={card.role === 'universal'} compact />
            </li>
          ))
        }
      </ul>
    </div>
  </main>
</Base>
