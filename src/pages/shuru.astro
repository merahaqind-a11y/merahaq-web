---
import Base from '../layouts/Base.astro';
import Header from '../components/chrome/Header.astro';
import Diagnostic from '../components/diagnostic/Diagnostic.astro';

const lang = 'hi' as const;
---

{
  /* `rights` blocks machine translation (D9). The diagnostic statements are
 safety-designed to describe events rather than accuse anyone, and a machine
 translation can flip that in a single word. */
}
<Base title="मेरा हक़, पाँच सवाल" lang={lang} rights>
  {
    /* No login on app routes, it would crowd the two fixed safety controls, and
 login is never required for anything. */
  }
  <Header lang={lang} />

  <main id="main">
    <Diagnostic lang={lang} />
  </main>
</Base>
