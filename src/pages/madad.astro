---
import Base from '../layouts/Base.astro';
import Header from '../components/chrome/Header.astro';
import DraftBanner from '../components/chrome/DraftBanner.astro';
import CardIcon from '../components/card/CardIcon.astro';
import SunieButton from '../components/chrome/SunieButton.astro';
import { CARD_LIST, VERIFIED_ON_DISPLAY } from '../lib/cards';
import { body } from '../content/cards';
import { t } from '../lib/i18n';

const lang = 'hi' as const;

/**
 * F-40. This page is for INSTANT REDRESSAL only. Not a resources page, not a link farm.
 * For each card: where to go, who to ask for, what number to press. Anything that is
 * not an immediate route to help belongs on the card, not here.
 *
 * It is fully static — native <details>, no hydration — because this is the page most
 * likely to be needed when the data has run out, and it must work offline and with
 * JavaScript off.
 */
const UNIVERSAL = [
  { n: '181', key: 'helpline.181' },
  { n: '112', key: 'helpline.112' },
  { n: '15100', key: 'helpline.15100' },
  { n: '14454', key: 'helpline.14454' },
  { n: '1930', key: 'helpline.1930' },
  { n: '14448', key: 'helpline.14448' },
  { n: '14490', key: 'helpline.14490' },
] as const;
---

<Base title="अभी मदद लीजिए — मेरा हक़" lang={lang} rights>
  <Header lang={lang} />
  <DraftBanner lang={lang} />

  <main id="main" class="relative overflow-hidden px-5 pt-8 pb-16">
    <div class="bloom" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl">
      <h1
        class="shirorekha text-section leading-tight font-bold text-ink"
        style="--shirorekha-width:3.5rem"
        data-i18n="madad.title"
      >
        {t('madad.title', lang)}
      </h1>

      <div class="mt-5">
        <SunieButton lang={lang} target="madad" size="lg" />
      </div>

      {/* ── the universal block, expanded on load ──────────────────────────── */}
      <section class="mt-8" aria-labelledby="universal-heading">
        <h2
          id="universal-heading"
          class="text-[0.9375rem] font-bold tracking-wide text-muted uppercase"
          data-i18n="madad.universal"
        >
          {t('madad.universal', lang)}
        </h2>

        <ul class="mt-4 grid gap-2">
          {
            UNIVERSAL.map(({ n, key }) => (
              <li>
                <a
                  href={`tel:${n}`}
                  data-testid={`tel-${n}`}
                  class="flex tap-lg items-center gap-4 rounded-action border border-blue-600/25
                         bg-surface px-4 text-ink no-underline"
                >
                  <span class="mono w-20 shrink-0 text-[1.375rem] font-bold text-blue-600">{n}</span>
                  <span class="min-w-0 flex-1 text-[0.9375rem] text-muted" data-i18n={key}>
                    {t(key, lang)}
                  </span>
                  <span class="flex shrink-0 items-center gap-1 font-bold text-blue-600">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a1 1 0 01-1 1A16 16 0 014 5a1 1 0 011-1z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                    </svg>
                    <span data-i18n="helpline.press">{t('helpline.press', lang)}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      {/* ── then, by her card. Collapsed by default, one at a time. ──────────── */}
      <section class="mt-12" aria-labelledby="bycard-heading">
        <h2
          id="bycard-heading"
          class="text-[0.9375rem] font-bold tracking-wide text-muted uppercase"
          data-i18n="madad.byCard"
        >
          {t('madad.byCard', lang)}
        </h2>

        <div class="mt-4">
          {
            CARD_LIST.map((card) => {
              const b = body(card.id);
              const track = b[lang];
              return (
                <details name="madad" class="group border-b border-border" data-testid={`madad-${card.slug}`}>
                  <summary
                    class="flex tap-lg cursor-pointer list-none items-center gap-3 font-bold text-ink
                           [&::-webkit-details-marker]:hidden"
                  >
                    <CardIcon name={card.icon} size={22} />
                    <span data-card-title={card.id}>{card.title[lang]}</span>
                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      aria-hidden="true"
                      class="ms-auto shrink-0 text-pink-700 transition-transform group-open:rotate-45"
                    >
                      <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                    </svg>
                  </summary>

                  <div class="pb-6">
                    <p class="leading-relaxed font-bold text-ink">{track.authority.office}</p>
                    <p class="mt-1 text-muted">
                      <span data-i18n="card.askFor">{t('card.askFor', lang)}</span>:{' '}
                      {track.authority.askFor}
                    </p>

                    <ul class="mt-4 flex flex-wrap gap-2">
                      {b.numbers.map((n) => (
                        <li>
                          <a
                            href={`tel:${n.replace(/[^0-9+]/g, '')}`}
                            class="mono flex tap-lg items-center rounded-action bg-blue-050 px-4
                                   text-[1.125rem] font-bold text-blue-600 no-underline"
                          >
                            {n}
                          </a>
                        </li>
                      ))}
                    </ul>

                    <ul class="mt-3 flex flex-wrap gap-2">
                      {b.portals.map((p) => (
                        <li>
                          <a
                            href={p.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="mono inline-flex tap items-center gap-1 rounded-action border
                                   border-border bg-surface px-3 text-[0.875rem] text-blue-600 no-underline"
                          >
                            {p.label}
                          </a>
                        </li>
                      ))}
                    </ul>

                    <a
                      href={`/card/${card.slug}`}
                      class="mt-4 inline-flex tap items-center font-bold text-pink-700 underline underline-offset-4"
                      data-i18n="card.open"
                    >
                      {t('card.open', lang)}
                    </a>
                  </div>
                </details>
              );
            })
          }
        </div>
      </section>

      {/* ── the shared-phone note, verbatim (F-07). Honest words, not clever tech. ── */}
      <section class="mt-12 border-s-[3px] border-ink bg-bg px-5 py-5">
        <p class="text-text" data-i18n="sharedPhone">{t('sharedPhone', lang)}</p>
      </section>

      <footer class="mt-8 text-[0.9375rem] text-muted">
        <p>
          <span class="font-bold text-ink" data-i18n="footer.disclaimer">
            {t('footer.disclaimer', lang)}
          </span>
          <span class="mx-2" aria-hidden="true">·</span>
          <span data-i18n="footer.verified">{t('footer.verified', lang)}</span>:
          <span class="mono">{VERIFIED_ON_DISPLAY[lang]}</span>
        </p>
      </footer>
    </div>
  </main>
</Base>
